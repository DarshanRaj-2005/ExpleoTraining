{
  "name": "cucumberplaywrightpom",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js src/test/features",
    "smoke": "cucumber-js src/test/features --tags @smoke",
    "regression": "cucumber-js src/test/features --tags @regression",
    "parallel": "cucumber-js src/test/features --parallel 2",
    "failed": "cucumber-js -p rerun",
    "ci": "cucumber-js src/test/features --tags @smoke --format json:reports/report.json",
    "posttest": "npx ts-node src/test/utils/report.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/winston": "^2.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "csv-parse": "^7.0.1",
    "multiple-cucumber-html-reporter": "^4.0.0"
  }
}
