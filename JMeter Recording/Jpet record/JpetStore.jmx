              <stringProp name="script">import org.apache.jmeter.services.FileServer;
def username = vars.get(&quot;username&quot;);
def password = vars.get(&quot;password&quot;);
log.info(&quot;username = &quot;+vars.get(&quot;username&quot;))
log.info(&quot;password = &quot;+vars.get(&quot;password&quot;)) 
f = new FileOutputStream(&quot;C:\Users\akksh\OneDrive\Desktop\apache-jmeter-5.6.3\bin\Apache Jmeter works\loginData.csv&quot;,true);
p=new PrintStream(f);
p.print(username+&quot;,&quot;+password+&quot;\r\n&quot;);
f.close();</stringProp>
